<UserControl x:Class="NekoNoTe.Recorder.RecorderPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:behaviors="clr-namespace:NekoNoTe.Behaviors"
             xmlns:rec="clr-namespace:NekoNoTe.Recorder"
             Background="Transparent">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="録音" FontSize="28" FontWeight="SemiBold"/>
            <TextBlock Text="ゲームの音や通話を録って、切り抜いて保存します · キーを押すと直前の数秒を保存します(さかのぼり録音)" Style="{StaticResource PageSubtitleStyle}"/>
        </StackPanel>

        <Grid Margin="-7,0,-7,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左: 設定と録ったもの -->
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource GlassCardStyle}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <ui:ToggleSwitch x:Name="EnabledToggle" DockPanel.Dock="Right" Click="Enabled_Click" ToolTip="録音のオン・オフ"/>
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource IconChipStyle}" Background="#26FF6B6B"><ui:SymbolIcon Symbol="Record24" FontSize="16" Foreground="#FF6B6B"/></Border>
                                <TextBlock Text="録り方" Style="{StaticResource CardTitleStyle}"/>
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Text="録る音" Style="{StaticResource FieldLabelStyle}"/>
                        <ComboBox x:Name="SourceCombo" SelectionChanged="Source_Changed"/>
                        <TextBlock Text="«PC の音» = ゲームや通話など、スピーカー・ヘッドホンから出ている音。マイクを選ぶと自分の声、VB-CABLE の «CABLE Output» を選ぶとそこに流している音(ゲームの VC など)だけを録ります" Style="{StaticResource NoteTextStyle}" Margin="0,4,0,0" TextWrapping="Wrap"/>

                        <DockPanel Margin="0,12,0,6">
                            <TextBlock x:Name="SecondsText" DockPanel.Dock="Right" Style="{StaticResource SliderValueStyle}"/>
                            <TextBlock Text="キーで保存する長さ(直前)" Style="{StaticResource FieldLabelStyle}" Margin="0"/>
                        </DockPanel>
                        <Slider x:Name="SecondsSlider" Minimum="5" Maximum="30" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Seconds_Changed"/>

                        <DockPanel Margin="0,10,0,0">
                            <ui:Button x:Name="KeyButton" DockPanel.Dock="Right" MinWidth="130" Height="30" Padding="10,0" Click="Key_Click"/>
                            <TextBlock Text="保存するキー" VerticalAlignment="Center" FontSize="13"/>
                        </DockPanel>

                        <Border Margin="0,12,0,0" Padding="10,8" CornerRadius="8" Background="#10FFFFFF">
                            <DockPanel>
                                <Ellipse x:Name="LiveDot" Width="8" Height="8" Fill="#4CD964" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="StatusText" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="ClipButton" Height="36" HorizontalAlignment="Stretch" Click="Clip_Click" ToolTip="直前の数秒を今すぐ保存する">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="History24" FontSize="15"/>
                                    <TextBlock Text="今のを保存" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="RecordButton" Grid.Column="2" Height="36" HorizontalAlignment="Stretch" Click="Record_Click">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon x:Name="RecordIcon" Symbol="Record24" FontSize="15" Foreground="#FF6B6B"/>
                                    <TextBlock x:Name="RecordText" Text="録音開始" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource GlassCardStyle}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" Width="32" Height="30" Padding="0" Click="OpenFolder_Click" ToolTip="エクスプローラーで開く">
                                <ui:SymbolIcon Symbol="FolderOpen24" FontSize="14"/>
                            </Button>
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource IconChipStyle}"><ui:SymbolIcon Symbol="TextBulletListLtr24" FontSize="16"/></Border>
                                <TextBlock Text="録ったもの" Style="{StaticResource CardTitleStyle}"/>
                            </StackPanel>
                        </DockPanel>
                        <Grid>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" behaviors:SmoothScrollBehavior.IsEnabled="True">
                                <StackPanel x:Name="ClipList" Margin="0,0,6,0"/>
                            </ScrollViewer>
                            <TextBlock x:Name="NoClipsText" Style="{StaticResource NoteTextStyle}" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center"
                                       Text="まだありません。&#10;ゲーム中にキーを押すか、«今のを保存» を押してください"/>
                        </Grid>
                    </DockPanel>
                </Border>
            </DockPanel>

            <!-- 右: 切り抜き -->
            <Border Grid.Column="1" Style="{StaticResource GlassCardStyle}">
                <Grid>
                    <DockPanel x:Name="Editor" Visibility="Collapsed">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                            <Button DockPanel.Dock="Right" Width="32" Height="32" Padding="0" Click="DeleteClip_Click" ToolTip="この録音を消す(ごみ箱へ)">
                                <ui:SymbolIcon Symbol="Delete24" FontSize="15"/>
                            </Button>
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource IconChipStyle}"><ui:SymbolIcon Symbol="Cut24" FontSize="16"/></Border>
                                <TextBlock Text="切り抜く" Style="{StaticResource CardTitleStyle}"/>
                                <TextBlock x:Name="ClipTitle" Style="{StaticResource NoteTextStyle}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DockPanel>

                        <StackPanel DockPanel.Dock="Bottom">
                            <Grid Margin="0,4,0,0">
                                <TextBlock x:Name="RangeText" FontSize="13" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <ui:SymbolIcon Symbol="Speaker224" FontSize="15" VerticalAlignment="Center" ToolTip="聴く時の音量(保存する音は変わりません)"/>
                                    <Slider x:Name="PreviewVolumeSlider" Width="110" Margin="8,0,6,0" Minimum="0" Maximum="100" VerticalAlignment="Center"
                                            ValueChanged="PreviewVolume_Changed" ToolTip="聴く時の音量(保存する音は変わりません)"/>
                                    <TextBlock x:Name="PreviewVolumeText" Style="{StaticResource SliderValueStyle}" Width="38" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <Button Height="34" Padding="12,0" Margin="0,0,6,0" Click="SelectAll_Click">全体を選ぶ</Button>
                                    <Button x:Name="PlayButton" Height="34" Padding="14,0" Style="{StaticResource AccentButtonStyle}" Click="Play_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon x:Name="PlayIcon" Symbol="Play24" FontSize="15"/>
                                            <TextBlock x:Name="PlayText" Text="選んだ所を聴く" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <WrapPanel Margin="0,12,0,0">
                                <CheckBox x:Name="NormalizeCheck" Content="音量をそろえる(大きく)" IsChecked="True" Margin="0,0,20,0"/>
                                <CheckBox x:Name="FadeCheck" Content="始まりと終わりをなめらかに" IsChecked="True"/>
                            </WrapPanel>

                            <Border Margin="0,14,0,0" Padding="14,12" CornerRadius="10" Background="#10FFFFFF">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <ui:SymbolIcon Symbol="Save24" FontSize="15" Foreground="{StaticResource AccentBrush}"/>
                                        <TextBlock Text="選んだ所を保存する" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <WrapPanel>
                                        <Button Height="34" Padding="14,0" Margin="0,0,8,0" Style="{StaticResource AccentButtonStyle}" Click="SaveCut_Click"
                                                ToolTip="切り抜いた所を «録ったもの» に新しく入れます(元の録音はそのまま)">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="Cut24" FontSize="14"/>
                                                <TextBlock Text="切り抜いて保存" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Height="34" Padding="14,0" Click="Export_Click" ToolTip="場所と名前を決めて WAV で書き出します">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="14"/>
                                                <TextBlock Text="書き出す…" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </WrapPanel>
                                    <TextBlock x:Name="AddResultText" Style="{StaticResource NoteTextStyle}" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <DockPanel>
                            <Grid DockPanel.Dock="Bottom" Margin="0,6,0,8">
                                <TextBlock x:Name="StartTimeText" Style="{StaticResource NoteTextStyle}" HorizontalAlignment="Left"/>
                                <TextBlock Text="波形をドラッグして範囲を選ぶ · 青い線をつかむと端だけ動きます" Style="{StaticResource NoteTextStyle}" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TotalTimeText" Style="{StaticResource NoteTextStyle}" HorizontalAlignment="Right"/>
                            </Grid>
                            <rec:WaveformView x:Name="Wave" MinHeight="160"/>
                        </DockPanel>
                    </DockPanel>

                    <StackPanel x:Name="EditorEmpty" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Cut24" FontSize="40" Opacity="0.5" HorizontalAlignment="Center"/>
                        <TextBlock Text="左の «録ったもの» から選ぶと、ここで切り抜けます" Style="{StaticResource NoteTextStyle}" Margin="0,10,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
