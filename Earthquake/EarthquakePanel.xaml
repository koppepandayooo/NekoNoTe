<UserControl x:Class="NekoNoTe.Earthquake.EarthquakePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:models="clr-namespace:NekoNoTe.Models"
             xmlns:behaviors="clr-namespace:NekoNoTe.Behaviors"
             Background="Transparent">
    <UserControl.Resources>
        <DataTemplate x:Key="StatBarRowTemplate">
            <Grid Margin="0,0,0,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="118"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="40"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <Border Grid.Column="1" Height="14" CornerRadius="3" Background="{Binding BarBrush}"
                        Width="{Binding BarWidth}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{Binding Count}" FontSize="12" FontWeight="SemiBold"
                           HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource ReadoutTextStyle}"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <TextBlock Text="地震情報" FontSize="28" FontWeight="SemiBold"/>
                    <TextBlock Text="データ: P2P地震情報 · 遅れたり届かないことがあります。スマホの緊急速報もオンにしておいてください" Style="{StaticResource PageSubtitleStyle}"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                    <Button x:Name="EarthquakeSubTabListButton" Content="一覧" Width="90" Height="30"
                            Style="{StaticResource AccentButtonStyle}" Click="EarthquakeSubTab_Click"/>
                    <Button x:Name="EarthquakeSubTabStatsButton" Content="統計" Width="90" Height="30" Margin="8,0,0,0"
                            Click="EarthquakeSubTab_Click"/>
                </StackPanel>

                <Grid>
                <Grid x:Name="EarthquakeListView">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左: 一覧 -->
                    <Grid Grid.Column="0">
                        <TextBlock x:Name="EmptyEarthquakeText" Text="まだ地震情報はありません" Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,24,0,0"/>
                        <ListView x:Name="EarthquakeList" BorderThickness="0" Background="Transparent"
                                  ScrollViewer.CanContentScroll="False"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.PanningMode="VerticalOnly"
                                  behaviors:SmoothScrollBehavior.IsEnabled="True"
                                  SelectionChanged="EarthquakeList_SelectionChanged">
                            <ListView.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.ContainerStyle>
                                        <Style TargetType="GroupItem">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="GroupItem">
                                                        <StackPanel>
                                                            <Grid Margin="0,8,14,8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding Name, StringFormat='{}{0:yyyy年M月d日（ddd）}'}"
                                                                           FontSize="12.5" FontWeight="SemiBold"
                                                                           Foreground="{StaticResource AccentBrush}"/>
                                                                <Rectangle Grid.Column="1" Height="1" Fill="{StaticResource BorderBrush2}"
                                                                           Margin="10,0" VerticalAlignment="Center"/>
                                                                <TextBlock Grid.Column="2" Text="{Binding ItemCount, StringFormat='{}{0}件'}"
                                                                           FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                            </Grid>
                                                            <ItemsPresenter/>
                                                        </StackPanel>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </GroupStyle.ContainerStyle>
                                </GroupStyle>
                            </ListView.GroupStyle>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Margin" Value="0,0,14,6"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#0FFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="10" Padding="12,9">
                                        <StackPanel>
                                            <!-- 1行目: 種類のラベルと時刻(タイトルと横に並べると折り返すので分ける) -->
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding ReportedAt, StringFormat='{}{0:HH:mm:ss}'}"
                                                           FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                <Border x:Name="AlertKindBadge" Background="#263B52" CornerRadius="5" Padding="7,1" HorizontalAlignment="Left">
                                                    <TextBlock x:Name="AlertKindBadgeText" Text="{Binding AlertKindLabel}" FontSize="10.5"
                                                               FontWeight="SemiBold" Foreground="#9ADFFF"/>
                                                </Border>
                                            </DockPanel>
                                            <TextBlock Text="{Binding ListSummaryLabel}" FontWeight="SemiBold" FontSize="14"
                                                       TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/>
                                            <TextBlock x:Name="EarthquakeLocationText" Text="{Binding EarthquakeLocationLabel}" FontSize="12"
                                                       Foreground="{StaticResource AccentBrush}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:AlertKind.EewWarning}">
                                            <Setter TargetName="AlertKindBadge" Property="Background" Value="#4A3120"/>
                                            <Setter TargetName="AlertKindBadgeText" Property="Foreground" Value="#FFB454"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:AlertKind.Tsunami}">
                                            <Setter TargetName="AlertKindBadge" Property="Background" Value="#203D5B"/>
                                            <Setter TargetName="AlertKindBadgeText" Property="Foreground" Value="#68B9FF"/>
                                            <Setter TargetName="EarthquakeLocationText" Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>

                    <!-- 右: 詳細 -->
                    <Grid Grid.Column="2">
                        <Grid>
                        <Grid x:Name="EarthquakeDetailGrid" Visibility="Collapsed">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock x:Name="DetailTitleText" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="DetailTimeText" FontSize="12" Style="{StaticResource ReadoutTextStyle}"
                                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <Button x:Name="DetailDismissButton" Grid.Column="1" Content="✕ 選択解除"
                                            VerticalAlignment="Top" Height="28" Padding="10,0"
                                            Click="DetailDismissButton_Click"/>
                                </Grid>

                                <Border x:Name="DetailCountdownBorder" Background="#33DC2626" BorderBrush="#FFDC2626"
                                        BorderThickness="1" CornerRadius="6" Padding="18,14" Margin="0,16,0,0" Visibility="Collapsed">
                                    <StackPanel HorizontalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="⚠" FontSize="14" Foreground="#FFFF6B6B" VerticalAlignment="Center"/>
                                            <TextBlock Text="緊急地震速報 主要動到達まで（監視地域）" FontSize="12.5" FontWeight="SemiBold"
                                                       Foreground="#FFFF6B6B" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock x:Name="DetailCountdownNumberText" FontSize="52" FontWeight="Black" Foreground="White"
                                                   HorizontalAlignment="Center" FontFamily="Consolas" Margin="0,4,0,0"/>
                                        <TextBlock x:Name="DetailCountdownCaptionText" FontSize="11.5" Foreground="#FFE5B4B4"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="320"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="340"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 震度分布(地図) -->
                                    <Border Grid.Column="0" Background="#0FFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="12" Padding="16,14"
                                            VerticalAlignment="Top">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                <Border Style="{StaticResource IconChipStyle}"><ui:SymbolIcon Symbol="Map24" FontSize="16"/></Border>
                                                <TextBlock Text="震度分布" Style="{StaticResource CardTitleStyle}"/>
                                            </StackPanel>
                                            <Viewbox Height="420" Stretch="Uniform" StretchDirection="Both" HorizontalAlignment="Center">
                                                <Canvas x:Name="EarthquakeMapHost"/>
                                            </Viewbox>
                                        <WrapPanel Margin="0,12,0,0">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,10,4">
                                                <Rectangle Width="10" Height="10" Fill="#3B82F6"/>
                                                <TextBlock Text="1" FontSize="10" Margin="4,0,0,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,10,4">
                                                <Rectangle Width="10" Height="10" Fill="#22C55E"/>
                                                <TextBlock Text="2" FontSize="10" Margin="4,0,0,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,10,4">
                                                <Rectangle Width="10" Height="10" Fill="#84CC16"/>
                                                <TextBlock Text="3" FontSize="10" Margin="4,0,0,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,10,4">
                                                <Rectangle Width="10" Height="10" Fill="#EAB308"/>
                                                <TextBlock Text="4" FontSize="10" Margin="4,0,0,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,10,4">
                                                <Rectangle Width="10" Height="10" Fill="#F97316"/>
                                                <TextBlock Text="5弱" FontSize="10" Margin="4,0,0,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,10,4">
                                                <Rectangle Width="10" Height="10" Fill="#EF4444"/>
                                                <TextBlock Text="5強" FontSize="10" Margin="4,0,0,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,10,4">
                                                <Rectangle Width="10" Height="10" Fill="#DC2626"/>
                                                <TextBlock Text="6弱" FontSize="10" Margin="4,0,0,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,10,4">
                                                <Rectangle Width="10" Height="10" Fill="#B91C1C"/>
                                                <TextBlock Text="6強" FontSize="10" Margin="4,0,0,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,10,4">
                                                <Rectangle Width="10" Height="10" Fill="#7C3AED"/>
                                                <TextBlock Text="7" FontSize="10" Margin="4,0,0,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                        </WrapPanel>
                                        </StackPanel>
                                    </Border>

                                    <StackPanel Grid.Column="2">
                                        <!-- 震源情報 -->
                                        <Border Background="#0FFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="12" Padding="16,14">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                                    <Border Style="{StaticResource IconChipStyle}"><ui:SymbolIcon Symbol="Location24" FontSize="16"/></Border>
                                                    <TextBlock Text="震源情報" Style="{StaticResource CardTitleStyle}"/>
                                                </StackPanel>
                                                <TextBlock Text="震源地" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,2"/>
                                                <TextBlock x:Name="DetailHypocenterText" FontSize="20" FontWeight="Bold" TextWrapping="Wrap"/>
                                                <Grid Margin="0,12,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="8"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border CornerRadius="10" Background="#0CFFFFFF" Padding="12,8">
                                                        <StackPanel>
                                                            <TextBlock Text="マグニチュード" Style="{StaticResource FieldLabelStyle}" Margin="0"/>
                                                            <TextBlock x:Name="DetailMagnitudeText" FontSize="22" FontWeight="Bold" FontFamily="Segoe UI Variable Display, Segoe UI"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Grid.Column="2" CornerRadius="10" Background="#0CFFFFFF" Padding="12,8">
                                                        <StackPanel>
                                                            <TextBlock Text="深さ" Style="{StaticResource FieldLabelStyle}" Margin="0"/>
                                                            <TextBlock x:Name="DetailDepthText" FontSize="22" FontWeight="Bold" FontFamily="Segoe UI Variable Display, Segoe UI"/>
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                                <Grid Margin="0,12,0,0">
                                                    <TextBlock Text="座標" Style="{StaticResource FieldLabelStyle}" Margin="0"/>
                                                    <TextBlock x:Name="DetailCoordinateText" FontSize="12.5" HorizontalAlignment="Right"/>
                                                </Grid>
                                                <Grid Margin="0,6,0,0">
                                                    <TextBlock Text="津波" Style="{StaticResource FieldLabelStyle}" Margin="0"/>
                                                    <TextBlock x:Name="DetailTsunamiText" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Right"
                                                               TextWrapping="Wrap" TextAlignment="Right" MaxWidth="230"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- 地域別の震度 -->
                                        <Border Background="#0FFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="12" Padding="16,14" Margin="0,12,0,0">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                    <Border Style="{StaticResource IconChipStyle}"><ui:SymbolIcon Symbol="TextBulletListLtr24" FontSize="16"/></Border>
                                                    <TextBlock Text="地域別の震度" Style="{StaticResource CardTitleStyle}"/>
                                                </StackPanel>
                                                <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto"
                                                              behaviors:SmoothScrollBehavior.IsEnabled="True">
                                                    <ItemsControl x:Name="DetailPointsList" Margin="0,0,12,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#0CFFFFFF" CornerRadius="8" Padding="8,6" Margin="0,0,0,5">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Column="0" Background="{StaticResource AccentBrush}" CornerRadius="3"
                                                                    Padding="6,2" MinWidth="38" HorizontalAlignment="Left">
                                                                <TextBlock Text="{Binding ScaleLabel}" FontSize="11" FontWeight="SemiBold"
                                                                           HorizontalAlignment="Center" Foreground="#071521"/>
                                                            </Border>
                                                            <TextBlock Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center"
                                                                       FontSize="12.5" TextWrapping="Wrap">
                                                                <Run Text="{Binding Prefecture, Mode=OneWay}"/>
                                                                <Run Text=" "/>
                                                                <Run Text="{Binding Address, Mode=OneWay}"/>
                                                            </TextBlock>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <TextBlock x:Name="NoDetailSelectedText" Text="左の一覧から地震情報を選択してください"
                                   Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"
                                   VerticalAlignment="Top" Margin="0,24,0,0"/>
                        <Border x:Name="TsunamiDetailBorder" Visibility="Collapsed"
                                Background="{StaticResource SurfaceBrush}" BorderBrush="#5068B9FF"
                                BorderThickness="1" CornerRadius="6" Padding="20" VerticalAlignment="Top">
                            <StackPanel>
                                <Border Background="#203D5B" CornerRadius="3" Padding="7,3" HorizontalAlignment="Left">
                                    <TextBlock Text="津波情報" FontSize="11" FontWeight="SemiBold" Foreground="#68B9FF"/>
                                </Border>
                                <TextBlock x:Name="TsunamiDetailTitleText" FontSize="20" FontWeight="SemiBold" Margin="0,14,0,0"/>
                                <TextBlock x:Name="TsunamiDetailTimeText" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,5,0,0"/>
                                <Rectangle Height="1" Fill="{StaticResource BorderBrush2}" Margin="0,16"/>
                                <TextBlock x:Name="TsunamiDetailBodyText" FontSize="14" TextWrapping="Wrap"/>
                                <TextBlock Text="気象庁など公的機関の避難情報を必ず確認してください。"
                                           Foreground="{StaticResource ActivityWarningBrush}" FontSize="11.5" Margin="0,16,0,0"/>
                            </StackPanel>
                        </Border>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- 統計 -->
                <ScrollViewer x:Name="EarthquakeStatsView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"
                              behaviors:SmoothScrollBehavior.IsEnabled="True">
                    <StackPanel>
                        <TextBlock x:Name="EarthquakeStatsSummaryText" FontSize="12.5"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,14"/>
                        <WrapPanel>
                            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush2}"
                                    BorderThickness="1" CornerRadius="8" Padding="22,18" Width="440" Margin="0,0,18,18" VerticalAlignment="Top">
                                <StackPanel>
                                    <TextBlock Text="震源地別 発生回数(上位10)" FontWeight="SemiBold" FontSize="13.5" Margin="0,0,0,12"/>
                                    <TextBlock x:Name="StatsHypocenterEmptyText" Text="集計できる地震情報がありません"
                                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5"/>
                                    <ItemsControl x:Name="StatsHypocenterList" ItemTemplate="{StaticResource StatBarRowTemplate}"/>
                                </StackPanel>
                            </Border>

                            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush2}"
                                    BorderThickness="1" CornerRadius="8" Padding="22,18" Width="440" Margin="0,0,18,18" VerticalAlignment="Top">
                                <StackPanel>
                                    <TextBlock Text="最大震度別 件数" FontWeight="SemiBold" FontSize="13.5" Margin="0,0,0,12"/>
                                    <ItemsControl x:Name="StatsScaleList" ItemTemplate="{StaticResource StatBarRowTemplate}"/>
                                </StackPanel>
                            </Border>

                            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush2}"
                                    BorderThickness="1" CornerRadius="8" Padding="22,18" Width="440" Margin="0,0,18,18" VerticalAlignment="Top">
                                <StackPanel>
                                    <TextBlock Text="日別 発生件数(直近14日)" FontWeight="SemiBold" FontSize="13.5" Margin="0,0,0,12"/>
                                    <ItemsControl x:Name="StatsDailyList" ItemTemplate="{StaticResource StatBarRowTemplate}"/>
                                </StackPanel>
                            </Border>
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
                </Grid>
            </DockPanel>
</UserControl>
