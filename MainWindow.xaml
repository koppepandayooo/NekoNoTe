<ui:FluentWindow x:Class="NekoNoTe.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:behaviors="clr-namespace:NekoNoTe.Behaviors"
        xmlns:roblox="clr-namespace:NekoNoTe.Roblox"
        xmlns:home="clr-namespace:NekoNoTe.Home"
        xmlns:earthquake="clr-namespace:NekoNoTe.Earthquake"
        xmlns:updates="clr-namespace:NekoNoTe.Updates"
        xmlns:settings="clr-namespace:NekoNoTe.Settings"
        xmlns:lanshare="clr-namespace:NekoNoTe.LanShare"
        Title="NekoNoTe"
        Width="1536" Height="864"
        MinWidth="860" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        FontFamily="Yu Gothic UI, Segoe UI Variable, Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== 背景画像(設定した時だけ表示して、その上に半透明の背景色を重ねる) ===== -->
        <Image x:Name="BackgroundImage" Grid.RowSpan="2" Stretch="UniformToFill" Margin="-90" IsHitTestVisible="False" Visibility="Collapsed">
            <Image.Effect>
                <BlurEffect x:Name="BackgroundBlur" Radius="70" KernelType="Gaussian" RenderingBias="Performance"/>
            </Image.Effect>
        </Image>
        <Rectangle x:Name="BackgroundShade" Grid.RowSpan="2" IsHitTestVisible="False" Visibility="Collapsed">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#5C0A0A12" Offset="0"/>
                    <GradientStop Color="#A60A0A12" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <ui:TitleBar Grid.Row="0" Title="" Height="44" Padding="16,0,0,0"/>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left"
                    IsHitTestVisible="False">
            <ui:SymbolIcon Symbol="AnimalCat24" Filled="True" FontSize="20" Foreground="{StaticResource AccentBrush}"/>
            <TextBlock Text="NekoNoTe" FontSize="14" FontWeight="SemiBold" Margin="10,0,0,1" VerticalAlignment="Center"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="232"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== 左サイドバー(機能を足す時は、ここにボタン、右にパネルを足して MainWindow.xaml.cs の Pages に並べる) ===== -->
            <Border x:Name="SidebarBorder" Grid.Column="0" Background="Transparent">
                <DockPanel Margin="0,8,0,12">
                    <StackPanel DockPanel.Dock="Bottom">
                        <ToggleButton x:Name="UpdateNavButton" Style="{StaticResource NavButtonStyle}" Click="NavButton_Click">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="18" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="アップデート" FontSize="13.5" VerticalAlignment="Center"/>
                                <Ellipse x:Name="UpdateNavActivity" Grid.Column="2" Width="7" Height="7" Fill="{StaticResource ActivityWarningBrush}"
                                         HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed" ToolTip="新しいバージョンがあります"/>
                            </Grid>
                        </ToggleButton>
                        <ToggleButton x:Name="SettingsNavButton" Style="{StaticResource NavButtonStyle}" Click="NavButton_Click">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="Settings24" FontSize="18" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="設定" FontSize="13.5" VerticalAlignment="Center"/>
                            </Grid>
                        </ToggleButton>
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" behaviors:SmoothScrollBehavior.IsEnabled="True">
                        <StackPanel>
                            <ToggleButton x:Name="HomeNavButton" Style="{StaticResource NavButtonStyle}" IsChecked="True" Click="NavButton_Click">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Symbol="Home24" FontSize="18" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="ホーム" FontSize="13.5" VerticalAlignment="Center"/>
                                </Grid>
                            </ToggleButton>

                            <TextBlock Text="防災" Style="{StaticResource SidebarSectionStyle}"/>
                            <ToggleButton x:Name="EarthquakeNavButton" Style="{StaticResource NavButtonStyle}" Click="NavButton_Click">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Symbol="Pulse24" FontSize="18" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="地震" FontSize="13.5" VerticalAlignment="Center"/>
                                    <Border Grid.Column="2" HorizontalAlignment="Right" CornerRadius="8" Padding="7,1" Background="#14FFFFFF" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="EarthquakeNavDot" Width="6" Height="6" Fill="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="EarthquakeNavText" Text="接続中" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="5,0,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </ToggleButton>

                            <TextBlock Text="ゲーム" Style="{StaticResource SidebarSectionStyle}"/>
                            <ToggleButton x:Name="RobloxNavButton" Style="{StaticResource NavButtonStyle}" Click="NavButton_Click">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Symbol="Cube24" FontSize="18" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Roblox" FontSize="13.5" VerticalAlignment="Center"/>
                                </Grid>
                            </ToggleButton>

                            <TextBlock Text="ツール" Style="{StaticResource SidebarSectionStyle}"/>
                            <ToggleButton x:Name="LanShareNavButton" Style="{StaticResource NavButtonStyle}" Click="NavButton_Click">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Symbol="Share24" FontSize="18" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="LAN 共有" FontSize="13.5" VerticalAlignment="Center"/>
                                    <Border x:Name="LanShareNavActivity" Grid.Column="2" HorizontalAlignment="Right" CornerRadius="8" Padding="7,1"
                                            Background="#264CD964" VerticalAlignment="Center" Visibility="Collapsed">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="6" Height="6" Fill="#4CD964" VerticalAlignment="Center"/>
                                            <TextBlock Text="オン" FontSize="10" Foreground="#4CD964" Margin="5,0,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </ToggleButton>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Border x:Name="ContentBorder" Grid.Column="1" Background="{StaticResource LayerBrush}"
                    BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1,1,0,0" CornerRadius="8,0,0,0">
                <Grid Margin="40,34,40,28">
                    <earthquake:EarthquakePanel x:Name="EarthquakePanel" Visibility="Collapsed"/>
                    <home:HomePanel x:Name="HomePanel"/>
                    <roblox:RobloxPanel x:Name="RobloxPanel" Visibility="Collapsed"/>
                    <lanshare:LanSharePanel x:Name="LanSharePanel" Visibility="Collapsed"/>
                    <updates:UpdatePanel x:Name="UpdatePanel" Visibility="Collapsed"/>
                    <settings:SettingsPanel x:Name="SettingsPanel" Visibility="Collapsed"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
