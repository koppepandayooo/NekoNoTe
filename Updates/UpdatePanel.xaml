<UserControl x:Class="NekoNoTe.Updates.UpdatePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Background="Transparent">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <TextBlock Text="アップデート" FontSize="28" FontWeight="SemiBold"/>
            <TextBlock Text="GitHub のリリースから新しいバージョンを入れます" Style="{StaticResource PageSubtitleStyle}"/>
        </StackPanel>

        <Border Margin="-7,0,-7,0" VerticalAlignment="Top" Style="{StaticResource GlassCardStyle}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <Border Style="{StaticResource IconChipStyle}"><ui:SymbolIcon Symbol="ArrowDownload24" FontSize="16"/></Border>
                    <TextBlock Text="バージョン" Style="{StaticResource CardTitleStyle}"/>
                </StackPanel>
                <TextBlock x:Name="CurrentText" FontSize="24" FontWeight="SemiBold"/>
                <TextBlock x:Name="StatusText" Style="{StaticResource NoteTextStyle}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                <ProgressBar x:Name="Progress" Height="4" Margin="0,12,0,0" Minimum="0" Maximum="1" Visibility="Collapsed"/>
                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <Button x:Name="CheckButton" Height="36" Padding="14,0" Click="Check_Click">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowSync24" FontSize="15"/>
                            <TextBlock Text="確認する" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="InstallButton" Height="36" Padding="14,0" Margin="8,0,0,0" Style="{StaticResource AccentButtonStyle}"
                            Click="Install_Click" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="15"/>
                            <TextBlock Text="アップデートして再起動" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <TextBlock x:Name="NotesTitle" Text="新しいバージョンの内容" Style="{StaticResource FieldLabelStyle}" Margin="0,18,0,6" Visibility="Collapsed"/>
                <TextBlock x:Name="NotesText" TextWrapping="Wrap" FontSize="12.5" Visibility="Collapsed"/>
            </StackPanel>
        </Border>
    </DockPanel>
</UserControl>
