<UserControl x:Class="NekoNoTe.Home.HomePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:behaviors="clr-namespace:NekoNoTe.Behaviors"
             Background="Transparent">
    <DockPanel>
        <!-- あいさつと時計 -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,18">
            <StackPanel VerticalAlignment="Bottom">
                <TextBlock x:Name="GreetingText" Text="こんにちは" FontSize="34" FontWeight="Bold"/>
                <TextBlock x:Name="StatusLineText" Style="{StaticResource PageSubtitleStyle}"/>
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <TextBlock x:Name="ClockText" FontSize="44" FontWeight="Bold" HorizontalAlignment="Right" FontFamily="Segoe UI Variable Display, Segoe UI"/>
                <TextBlock x:Name="DateText" Style="{StaticResource NoteTextStyle}" HorizontalAlignment="Right"/>
            </StackPanel>
        </Grid>

        <ScrollViewer VerticalScrollBarVisibility="Auto" behaviors:SmoothScrollBehavior.IsEnabled="True">
            <Grid Margin="-7,0,-7,8" VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 直近の地震 -->
                <Border Grid.Column="0" Style="{StaticResource GlassCardStyle}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,14">
                            <Border Style="{StaticResource IconChipStyle}"><ui:SymbolIcon Symbol="Pulse24" FontSize="16"/></Border>
                            <TextBlock Text="直近の地震" Style="{StaticResource CardTitleStyle}"/>
                        </StackPanel>
                        <Button DockPanel.Dock="Bottom" Content="地震タブを開く" Height="34" Padding="12,0" Margin="0,14,0,0" Click="OpenEarthquake_Click"/>
                        <Grid>
                            <TextBlock x:Name="RecentEmptyText" Text="まだ地震情報はありません" Style="{StaticResource NoteTextStyle}"/>
                            <StackPanel x:Name="RecentContent" Visibility="Collapsed">
                                <TextBlock x:Name="RecentTitleText" FontSize="22" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="RecentPlaceText" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="RecentTimeText" Style="{StaticResource NoteTextStyle}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </DockPanel>
                </Border>

                <!-- 緊急地震速報 -->
                <Border Grid.Column="1" Style="{StaticResource GlassCardStyle}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,14">
                            <Border Style="{StaticResource IconChipStyle}"><ui:SymbolIcon Symbol="Alert24" FontSize="16"/></Border>
                            <TextBlock Text="緊急地震速報" Style="{StaticResource CardTitleStyle}"/>
                        </StackPanel>
                        <Button DockPanel.Dock="Bottom" Content="設定を開く" Height="34" Padding="12,0" Margin="0,14,0,0" Click="OpenSettings_Click"/>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="QuakeDot" Width="10" Height="10" Fill="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="QuakeStatusText" Text="接続中" FontSize="20" FontWeight="Bold" Margin="10,0,0,0"/>
                            </StackPanel>
                            <TextBlock x:Name="QuakeNoteText" Style="{StaticResource NoteTextStyle}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Roblox -->
                <Border Grid.Column="2" Style="{StaticResource GlassCardStyle}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,14">
                            <Border Style="{StaticResource IconChipStyle}"><ui:SymbolIcon Symbol="Cube24" FontSize="16"/></Border>
                            <TextBlock Text="Roblox" Style="{StaticResource CardTitleStyle}"/>
                        </StackPanel>
                        <Button DockPanel.Dock="Bottom" Content="Roblox タブを開く" Height="34" Padding="12,0" Margin="0,14,0,0" Click="OpenRoblox_Click"/>
                        <StackPanel>
                            <TextBlock x:Name="RobloxCountText" FontSize="22" FontWeight="Bold"/>
                            <TextBlock x:Name="RobloxNoteText" Style="{StaticResource NoteTextStyle}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</UserControl>
