<UserControl x:Class="NekoNoTe.Settings.SettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:behaviors="clr-namespace:NekoNoTe.Behaviors"
             Background="Transparent">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="設定" FontSize="28" FontWeight="SemiBold"/>
                <Border CornerRadius="10" Padding="10,3" Margin="14,0,0,0" Background="#2660CDFF" VerticalAlignment="Center"
                        Visibility="{Binding Visibility, ElementName=SavedText}" Opacity="{Binding Opacity, ElementName=SavedText}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Checkmark24" FontSize="12" Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock x:Name="SavedText" Text="保存しました" Foreground="{StaticResource AccentBrush}" FontSize="11.5" FontWeight="SemiBold"
                                   Margin="5,0,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>
            </StackPanel>
            <TextBlock Text="変更はすぐに保存されます" Style="{StaticResource PageSubtitleStyle}"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" behaviors:SmoothScrollBehavior.IsEnabled="True">
            <Grid Margin="-7,0,-7,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <!-- 通知 -->
                    <Border Style="{StaticResource GlassCardStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <Border Style="{StaticResource IconChipStyle}"><ui:SymbolIcon Symbol="Alert24" FontSize="16"/></Border>
                                <TextBlock Text="通知" Style="{StaticResource CardTitleStyle}"/>
                            </StackPanel>
                            <TextBlock Text="表示するモニター" Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox x:Name="MonitorCombo" DisplayMemberPath="Label" Margin="0,0,0,14" SelectionChanged="Setting_SelectionChanged"/>
                            <TextBlock Text="表示する位置" Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox x:Name="CornerCombo" DisplayMemberPath="Name" Margin="0,0,0,14" SelectionChanged="Setting_SelectionChanged"/>
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="表示時間" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBlock Text="{Binding ElementName=DurationSlider, Path=Value, StringFormat={}{0:0} 秒}" Style="{StaticResource SliderValueStyle}"/>
                            </Grid>
                            <Slider x:Name="DurationSlider" Minimum="3" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True"
                                    ValueChanged="Setting_ValueChanged" Margin="0,0,0,14"/>
                            <TextBlock Text="通知音" Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox x:Name="SoundCombo" DisplayMemberPath="Name" Margin="0,0,0,14" SelectionChanged="SoundCombo_SelectionChanged"/>
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="音量" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBlock Text="{Binding ElementName=VolumeSlider, Path=Value, StringFormat={}{0:0}%}" Style="{StaticResource SliderValueStyle}"/>
                            </Grid>
                            <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" TickFrequency="10" IsSnapToTickEnabled="True" ValueChanged="Setting_ValueChanged"/>
                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Height="36" HorizontalAlignment="Stretch" Click="TestNotification_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Alert24" FontSize="14"/>
                                        <TextBlock Text="テスト通知" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="2" Height="36" HorizontalAlignment="Stretch" Click="TestEew_Click"
                                        ToolTip="緊急地震速報の見え方を確かめます(実際の地震ではありません)">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Warning24" FontSize="14"/>
                                        <TextBlock Text="EEW テスト" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 起動 -->
                    <Border Style="{StaticResource GlassCardStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <Border Style="{StaticResource IconChipStyle}"><ui:SymbolIcon Symbol="Power24" FontSize="16"/></Border>
                                <TextBlock Text="起動" Style="{StaticResource CardTitleStyle}"/>
                            </StackPanel>
                            <DockPanel>
                                <ui:ToggleSwitch x:Name="StartupToggle" DockPanel.Dock="Right" Click="Startup_Click"/>
                                <StackPanel>
                                    <TextBlock Text="Windows の起動時に常駐する" FontSize="13.5"/>
                                    <TextBlock Text="サインインした時に、タスクトレイで起動します" Style="{StaticResource NoteTextStyle}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DockPanel>
                            <DockPanel Margin="0,14,0,0">
                                <ui:ToggleSwitch x:Name="CloseToTrayToggle" DockPanel.Dock="Right" Click="Option_Click"/>
                                <StackPanel>
                                    <TextBlock Text="閉じてもタスクトレイに残る" FontSize="13.5"/>
                                    <TextBlock Text="オフにすると、閉じている間は地震の通知が届きません" Style="{StaticResource NoteTextStyle}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DockPanel>
                            <DockPanel Margin="0,14,0,0">
                                <ui:ToggleSwitch x:Name="UpdateCheckToggle" DockPanel.Dock="Right" Click="Option_Click"/>
                                <StackPanel>
                                    <TextBlock Text="起動時にアップデートを確認" FontSize="13.5"/>
                                    <TextBlock Text="新しいバージョンがあると、サイドバーに印が出ます" Style="{StaticResource NoteTextStyle}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DockPanel>
                            <TextBlock x:Name="ErrorText" Foreground="{StaticResource ActivityWarningBrush}" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <!-- 背景 -->
                    <Border Style="{StaticResource GlassCardStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <Border Style="{StaticResource IconChipStyle}"><ui:SymbolIcon Symbol="Image24" FontSize="16"/></Border>
                                <TextBlock Text="背景" Style="{StaticResource CardTitleStyle}"/>
                            </StackPanel>
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Content="画像を選択…" Height="32" Click="ChooseBackground_Click"/>
                                    <Button Content="解除" Height="32" Margin="8,0,0,0" Click="ClearBackground_Click"/>
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="背景画像" FontSize="13.5"/>
                                    <TextBlock x:Name="BackgroundPathText" Text="未設定" Style="{StaticResource NoteTextStyle}"
                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DockPanel>
                            <Grid Margin="0,16,0,4">
                                <TextBlock Text="ぼかし" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBlock Text="{Binding ElementName=BlurSlider, Path=Value}" Style="{StaticResource SliderValueStyle}"/>
                            </Grid>
                            <Slider x:Name="BlurSlider" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                                    ValueChanged="Background_ValueChanged" Margin="0,0,0,12"/>
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="暗さ" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBlock Text="{Binding ElementName=DimSlider, Path=Value, StringFormat={}{0:0}%}" Style="{StaticResource SliderValueStyle}"/>
                            </Grid>
                            <Slider x:Name="DimSlider" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="Background_ValueChanged"/>
                        </StackPanel>
                    </Border>

                    <!-- 地震 -->
                    <Border Style="{StaticResource GlassCardStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <Border Style="{StaticResource IconChipStyle}"><ui:SymbolIcon Symbol="Shield24" FontSize="16"/></Border>
                                <TextBlock Text="地震" Style="{StaticResource CardTitleStyle}"/>
                            </StackPanel>
                            <TextBlock Text="受信のしかた" Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox x:Name="SourceCombo" SelectionChanged="Source_Changed">
                                <ComboBoxItem Content="自動(同じネットワークの PC と共有する)" Tag="Auto"/>
                                <ComboBoxItem Content="このPCで直接受信する" Tag="Direct"/>
                                <ComboBoxItem Content="受信しない" Tag="Off"/>
                            </ComboBox>
                            <TextBlock Style="{StaticResource NoteTextStyle}" Margin="0,4,0,14" TextWrapping="Wrap"
                                       Text="自動にすると、同じネットワークの中の 1 台だけが受信して、他の PC に配ります。"/>
                            <TextBlock x:Name="FirewallText" Foreground="{StaticResource ActivityWarningBrush}" FontSize="12" Margin="0,-8,0,14" TextWrapping="Wrap" Visibility="Collapsed"
                                       Text="Windows のファイアウォールでブロックされているので、他の PC には共有できません(このPCでの受信はできます)。"/>
                            <TextBlock Text="地震を通知する最小震度" Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox x:Name="IntensityCombo" DisplayMemberPath="Name" Margin="0,0,0,14" SelectionChanged="Setting_SelectionChanged"/>
                            <TextBlock Text="住んでいる都道府県(緊急地震速報の到達予想に使います)" Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox x:Name="AreaCombo" SelectionChanged="Setting_SelectionChanged"/>
                        </StackPanel>
                    </Border>

                    <!-- データ -->
                    <Border Style="{StaticResource GlassCardStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <Border Style="{StaticResource IconChipStyle}"><ui:SymbolIcon Symbol="Folder24" FontSize="16"/></Border>
                                <TextBlock Text="データ" Style="{StaticResource CardTitleStyle}"/>
                            </StackPanel>
                            <TextBlock x:Name="DataPathText" Style="{StaticResource NoteTextStyle}" TextWrapping="Wrap"/>
                            <Button Height="34" Padding="12,0" Margin="0,12,0,0" Click="OpenData_Click">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="FolderOpen24" FontSize="14"/>
                                    <TextBlock Text="フォルダを開く" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- このアプリについて -->
                    <Border Style="{StaticResource GlassCardStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <Border Style="{StaticResource IconChipStyle}"><ui:SymbolIcon Symbol="Info24" FontSize="16"/></Border>
                                <TextBlock Text="このアプリについて" Style="{StaticResource CardTitleStyle}"/>
                            </StackPanel>
                            <TextBlock x:Name="VersionText" FontSize="13.5" FontWeight="SemiBold"/>
                            <TextBlock Style="{StaticResource NoteTextStyle}" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Text="GPL-3.0 で公開しています。Roblox の機能は Roblox Account Manager(作者 ic3w0lf22)を元にしています。地震のデータは P2P地震情報のものです。地図は「国土数値情報(行政区域データ)」(国土交通省、CC BY 4.0)を加工して作成しています。"/>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Height="34" Padding="12,0" Click="GitHub_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Open24" FontSize="14"/>
                                        <TextBlock Text="GitHub" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Height="34" Padding="12,0" Margin="6,0,0,0" Click="License_Click">
                                    <TextBlock Text="ライセンス" VerticalAlignment="Center"/>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</UserControl>
