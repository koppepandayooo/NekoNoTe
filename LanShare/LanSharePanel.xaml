<UserControl x:Class="NekoNoTe.LanShare.LanSharePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Background="Transparent">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <TextBlock Text="LAN 共有" FontSize="28" FontWeight="SemiBold"/>
            <TextBlock Text="同じネットワークの PC とファイルを送り合います · 相手の PC でも共有をオンにしてください" Style="{StaticResource PageSubtitleStyle}"/>
        </StackPanel>

        <Grid Margin="-7,0,-7,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*"/>
                <ColumnDefinition Width="7*"/>
            </Grid.ColumnDefinitions>

            <!-- この PC -->
            <Border Style="{StaticResource GlassCardStyle}" AllowDrop="True" Drop="Local_Drop" DragOver="Card_DragOver">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <DockPanel Margin="0,0,0,12">
                            <ui:ToggleSwitch x:Name="EnabledToggle" DockPanel.Dock="Right" Click="Enabled_Click"/>
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource IconChipStyle}"><ui:SymbolIcon Symbol="Desktop24" FontSize="16"/></Border>
                                <TextBlock Text="この PC の共有" Style="{StaticResource CardTitleStyle}"/>
                            </StackPanel>
                        </DockPanel>
                        <TextBlock x:Name="StateText" Style="{StaticResource NoteTextStyle}" TextWrapping="Wrap"/>

                        <DockPanel Margin="0,14,0,0">
                            <Button DockPanel.Dock="Right" Height="32" Padding="12,0" VerticalAlignment="Center" Click="ChangePin_Click" Content="PIN を変える"/>
                            <StackPanel>
                                <TextBlock Text="この PC の PIN(相手に入れてもらう)" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBlock x:Name="PinText" FontSize="34" FontWeight="Bold" FontFamily="Segoe UI Variable Display, Segoe UI"/>
                            </StackPanel>
                        </DockPanel>

                        <TextBlock Text="共有フォルダ(受け取ったファイルもここに入ります)" Style="{StaticResource FieldLabelStyle}" Margin="0,14,0,4"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Height="32" Padding="12,0" Margin="8,0,0,0" Click="OpenFolder_Click">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="FolderOpen24" FontSize="14"/>
                                    <TextBlock Text="開く" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <TextBlock x:Name="FolderText" Style="{StaticResource NoteTextStyle}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        </DockPanel>

                        <TextBlock x:Name="LocalCountText" Text="ここにあるファイル" Style="{StaticResource FieldLabelStyle}" Margin="0,16,0,4"/>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource NoteTextStyle}" Margin="0,8,0,0" TextWrapping="Wrap"
                               Text="ここにファイルをドロップすると、共有フォルダにコピーします"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="LocalList"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ほかの PC -->
            <Border Grid.Column="1" Style="{StaticResource GlassCardStyle}" AllowDrop="True" Drop="Remote_Drop" DragOver="Card_DragOver">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <DockPanel Margin="0,0,0,12">
                            <Button x:Name="SearchButton" DockPanel.Dock="Right" Height="32" Padding="12,0" Click="Search_Click">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="14"/>
                                    <TextBlock Text="探す" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource IconChipStyle}"><ui:SymbolIcon Symbol="Share24" FontSize="16"/></Border>
                                <TextBlock Text="ほかの PC" Style="{StaticResource CardTitleStyle}"/>
                            </StackPanel>
                        </DockPanel>
                        <WrapPanel x:Name="PeerList"/>
                        <TextBlock x:Name="PeerEmptyText" Style="{StaticResource NoteTextStyle}" TextWrapping="Wrap" Visibility="Collapsed"
                                   Text="見つかりません。相手の PC の NekoNoTe(または NekoApp)で «LAN 共有» をオンにしてください。同じ Wi-Fi・ルーターにつながっている必要があります。"/>

                        <!-- PIN を入れる -->
                        <Border x:Name="PinRow" Visibility="Collapsed" Margin="0,12,0,0" Padding="12,10" CornerRadius="8"
                                Background="#1F60CDFF" BorderBrush="#3360CDFF" BorderThickness="1">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Height="32" Padding="14,0" Margin="8,0,0,0" Click="PinOk_Click" Content="OK" IsDefault="True"/>
                                <TextBox x:Name="PinBox" DockPanel.Dock="Right" Width="90" FontSize="16" MaxLength="4" InputScope="Number" KeyDown="PinBox_KeyDown"/>
                                <TextBlock x:Name="PinPromptText" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            </DockPanel>
                        </Border>

                        <DockPanel x:Name="RemoteHeader" Margin="0,14,0,4" Visibility="Collapsed">
                            <Button DockPanel.Dock="Right" Height="32" Padding="12,0" Click="SendFiles_Click">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="ArrowUpload24" FontSize="14"/>
                                    <TextBlock Text="ファイルを送る" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <TextBlock x:Name="RemoteTitleText" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0"/>
                        </DockPanel>
                    </StackPanel>

                    <!-- 進み具合 -->
                    <Border x:Name="ProgressRow" DockPanel.Dock="Bottom" Visibility="Collapsed" Margin="0,10,0,0">
                        <DockPanel>
                            <Button x:Name="CancelButton" DockPanel.Dock="Right" Height="30" Padding="12,0" Margin="10,0,0,0" Click="Cancel_Click" Content="やめる"/>
                            <StackPanel>
                                <TextBlock x:Name="ProgressText" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                                <ProgressBar x:Name="Progress" Height="6" Margin="0,5,0,0" Minimum="0" Maximum="1"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <DockPanel x:Name="MessageRow" DockPanel.Dock="Bottom" Margin="0,10,0,0" Visibility="Collapsed">
                        <Button x:Name="MessageButton" DockPanel.Dock="Right" Height="30" Padding="12,0" Margin="10,0,0,0" Visibility="Collapsed" Click="MessageButton_Click"/>
                        <TextBlock x:Name="MessageText" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="12.5"/>
                    </DockPanel>
                    <TextBlock x:Name="DropHintText" DockPanel.Dock="Bottom" Style="{StaticResource NoteTextStyle}" Margin="0,8,0,0" Visibility="Collapsed"
                               Text="ここにファイルをドロップしても送れます · 受け取ったファイルは «ダウンロード» フォルダに入ります"/>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="RemoteList"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
