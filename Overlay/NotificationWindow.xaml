<Window x:Class="NekoNoTe.Overlay.NotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        SizeToContent="Height"
        Width="380"
        Opacity="1"
        Left="-4000"
        Top="-4000"
        Focusable="False"
        FontFamily="Yu Gothic UI">
    <!-- 影が切れないよう外側に余白を取る -->
    <Grid Margin="14">
        <Border x:Name="Card" CornerRadius="14" BorderThickness="1" BorderBrush="#2EFFFFFF" ClipToBounds="False">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#F2262630" Offset="0"/>
                    <GradientStop Color="#F21C1C22" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.55" Color="Black"/>
            </Border.Effect>
            <Grid>
                <!-- 種類の色をうっすら左上に敷く -->
                <Border CornerRadius="14" IsHitTestVisible="False">
                    <Border.Background>
                        <RadialGradientBrush Center="0,0" GradientOrigin="0,0" RadiusX="0.9" RadiusY="1.4">
                            <GradientStop x:Name="GlowStop" Color="#3360CDFF" Offset="0"/>
                            <GradientStop Color="#0060CDFF" Offset="1"/>
                        </RadialGradientBrush>
                    </Border.Background>
                </Border>

                <Grid Margin="12,10,14,11">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- アイコン -->
                    <Border x:Name="IconChip" Width="32" Height="32" CornerRadius="10" VerticalAlignment="Top" Margin="0,1,12,0"
                            Background="#2E60CDFF" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="IconScale" ScaleX="0.6" ScaleY="0.6"/>
                        </Border.RenderTransform>
                        <ui:SymbolIcon x:Name="KindIcon" Symbol="Alert24" FontSize="17" Foreground="#60CDFF"/>
                    </Border>

                    <StackPanel Grid.Column="1">
                        <DockPanel>
                            <TextBlock x:Name="TimeText" DockPanel.Dock="Right" FontSize="11" Foreground="#99FFFFFF"/>
                            <TextBlock x:Name="KindText" FontSize="11" FontWeight="SemiBold" Foreground="#60CDFF" Text="NekoNoTe"/>
                        </DockPanel>
                        <TextBlock x:Name="TitleText" FontSize="14.5" FontWeight="Bold" Foreground="#FFFFFF" TextWrapping="Wrap" Margin="0,1,0,0"/>
                        <TextBlock x:Name="BodyText" FontSize="12" Foreground="#C5FFFFFF" TextWrapping="Wrap" Margin="0,2,0,0" LineHeight="16"/>

                        <!-- 緊急地震速報: 主要動の到達までのカウントダウン -->
                        <Border x:Name="CountdownBorder" Visibility="Collapsed" Margin="0,8,0,0" Padding="10,4,10,6" CornerRadius="10"
                                Background="#33DC2626" BorderBrush="#99DC2626" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="CountdownNumberText" FontSize="30" FontWeight="Black" Foreground="White" VerticalAlignment="Center"/>
                                <StackPanel VerticalAlignment="Center" Margin="10,0,0,0">
                                    <TextBlock x:Name="CountdownCaptionText" FontSize="12.5" FontWeight="SemiBold" Foreground="White"/>
                                    <TextBlock x:Name="CountdownAreaText" FontSize="11" Foreground="#FFE5B4B4"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 残り時間 -->
                        <Border Height="2.5" CornerRadius="1.25" Background="#1AFFFFFF" Margin="0,8,0,0" ClipToBounds="True">
                            <Border x:Name="RemainingTimeBar" CornerRadius="1.25" HorizontalAlignment="Stretch" RenderTransformOrigin="0,0.5"
                                    Background="#60CDFF">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="1"/>
                                </Border.RenderTransform>
                            </Border>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
